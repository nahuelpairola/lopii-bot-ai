{
  "title": "Lopii — App State (admin)",
  "uid": "lopii-app-state",
  "description": "Estado de la app de un pantallazo. Fila 1: ¿está roto? Fila 2: ¿qué pasó? Fila 3: ¿cómo viene? Lee request_traces, llm_calls, intent_events y tablas de dominio. Al importar, elegí el datasource de Postgres.",
  "tags": ["lopii", "admin"],
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "5m",
  "time": { "from": "now-24h", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "DS_POSTGRES",
        "label": "Postgres datasource",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "pluginId": "grafana-postgresql-datasource",
        "current": {},
        "options": [],
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Updates (rango)",
      "description": "Volumen de updates de Telegram en la ventana. Es el denominador visual: 2 errores sobre 8 updates y 2 sobre 400 no son lo mismo.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"updates\" FROM request_traces WHERE $__timeFilter(received_at)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errores app",
      "description": "Cantidad absoluta, no tasa. A menos de 10 usuarios un porcentaje sobre 12 requests es ruido.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"errores app\" FROM request_traces WHERE $__timeFilter(received_at) AND error <> ''"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errores LLM",
      "description": "Incluye http_status >= 400, que es el caso que no se ve en errores app: Groq devuelve 429, el bot reintenta y responde con fallback, y el request termina 'bien'.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"errores llm\" FROM llm_calls WHERE $__timeFilter(created_at) AND (error <> '' OR http_status >= 400)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Latencia app máx",
      "description": "max, no p95. Con doce muestras, percentile_cont(0.95) es 'el segundo más lento' con interpolación arbitraria encima. El máximo es el peor rato que pasó un usuario.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "mappings": [],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3000 },
              { "color": "red", "value": 8000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(max(latency_ms), 0) AS \"app máx\" FROM request_traces WHERE $__timeFilter(received_at)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Latencia LLM máx",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "mappings": [],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3000 },
              { "color": "red", "value": 8000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(max(latency_ms), 0) AS \"llm máx\" FROM llm_calls WHERE $__timeFilter(created_at)"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Rate-limit Groq (req)",
      "description": "Requests restantes según el header de Groq. Umbral invertido: bajo es malo. 'No data' significa que Groq no mandó el header en el rango, no que se agotó.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 200 },
              { "color": "green", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT min(ratelimit_remaining_requests) AS \"req restantes\" FROM llm_calls WHERE $__timeFilter(created_at)"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Últimos errores (app + LLM)",
      "description": "Copiá el trace_id y pegalo en los logs de Render: internal/logging estampa ese mismo id en toda línea de log del request.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false, "filterable": true },
          "mappings": [],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "cuándo" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          },
          {
            "matcher": { "id": "byName", "options": "origen" },
            "properties": [
              { "id": "custom.width", "value": 80 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "app": { "color": "blue", "index": 0 },
                      "llm": { "color": "purple", "index": 1 }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "trace_id" },
            "properties": [{ "id": "custom.width", "value": 270 }]
          },
          {
            "matcher": { "id": "byName", "options": "detalle" },
            "properties": [{ "id": "custom.width", "value": 200 }]
          },
          {
            "matcher": { "id": "byName", "options": "ms" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "unit", "value": "ms" },
              { "id": "custom.align", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" },
        "sortBy": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS \"cuándo\", 'app' AS \"origen\", trace_id AS \"trace_id\", update_type AS \"detalle\", latency_ms AS \"ms\", error AS \"error\" FROM request_traces WHERE $__timeFilter(received_at) AND error <> '' UNION ALL SELECT created_at, 'llm', trace_id, call_type || ' / ' || model, latency_ms, coalesce(nullif(error, ''), 'HTTP ' || coalesce(http_status, 0)) FROM llm_calls WHERE $__timeFilter(created_at) AND (error <> '' OR http_status >= 400) ORDER BY 1 DESC LIMIT 50"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Actividad",
      "description": "Todo son conteos, así que comparten eje. Buckets vacíos rellenados con cero (tercer argumento de $__timeGroupAlias): a este volumen hay muchos buckets sin tráfico y sin relleno la línea aparenta continuidad.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "none",
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "none", "group": "A" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "updates" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "llm calls" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }]
          },
          {
            "matcher": { "id": "byName", "options": "errores" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(received_at,$__interval,0), count(*) AS \"updates\" FROM request_traces WHERE $__timeFilter(received_at) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at,$__interval,0), count(*) AS \"llm calls\" FROM llm_calls WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "C",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(received_at,$__interval,0), count(*) FILTER (WHERE error <> '') AS \"errores\" FROM request_traces WHERE $__timeFilter(received_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latencia máx",
      "description": "Panel aparte del de actividad porque milisegundos y conteos en un mismo panel exigirían un segundo eje Y. Acá NO se rellena con cero: un hueco de latencia rellenado con 0 se leería como 'respondió instantáneo'.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "mappings": [],
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "none", "group": "A" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "app máx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "llm máx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(received_at,$__interval) AS time, max(latency_ms) AS \"app máx\" FROM request_traces WHERE $__timeFilter(received_at) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(created_at,$__interval) AS time, max(latency_ms) AS \"llm máx\" FROM llm_calls WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    }
  ]
}

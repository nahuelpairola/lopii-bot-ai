              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT model, count(*) AS \"calls\", coalesce(sum(total_tokens), 0) AS \"tokens\", count(*) FILTER (WHERE attempts > 1) AS \"reintentos\", round(avg(latency_ms)) AS \"ms prom\", max(latency_ms) AS \"ms máx\" FROM llm_calls WHERE $__timeFilter(created_at) GROUP BY model ORDER BY \"calls\" DESC"

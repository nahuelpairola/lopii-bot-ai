package templates

type BarChartData struct {
	Labels []string  `json:"labels"`
	Values []float64 `json:"values"`
	Role   string    `json:"role"`
}

type CategoryRow struct {
	Category string
	Icon     string
	Href     string
	Total    string
	Share    string
	PerDay   string
}

type CategoriesData struct {
	Period     Period
	Rows       []CategoryRow
	Chart      BarChartData
	Total      string
	PerDayNote string
	Drill      string
	Empty      bool
}

templ Categories(data CategoriesData) {
	@PeriodHeader(data.Period)
	if data.Empty {
		@EmptyState("Sin gastos en este período.")
	} else {
		<p class="balance-line page-total">
			<span>Total</span>
			<span class="money">{ data.Total }</span>
		</p>
		<div class="chart-box">
			<canvas id="categorias-bars" aria-hidden="true" data-chart-type="bar-single" data-chart-data-id="categorias-bars-data"></canvas>
		</div>
		@templ.JSONScript("categorias-bars-data", data.Chart)
		@categoryTable(data, "Categoría")
	}
}

templ SubcategoryDrill(data CategoriesData) {
	@PeriodHeader(data.Period)
	<a class="tappable" href={ data.Period.Query() } hx-get={ data.Period.Query() } hx-target="#content" hx-push-url="true" hx-indicator="#content">&larr; Volver a Categorías</a>
	<h1>{ data.Drill }</h1>
	if data.Empty {
		@EmptyState("Sin gastos en esta categoría.")
	} else {
		<p class="balance-line page-total">
			<span>Total</span>
			<span class="money">{ data.Total }</span>
		</p>
		<div class="chart-box">
			<canvas id="subcat-bars" aria-hidden="true" data-chart-type="bar-single" data-chart-data-id="subcat-bars-data"></canvas>
		</div>
		@templ.JSONScript("subcat-bars-data", data.Chart)
		@categoryTable(data, "Subcategoría")
	}
}

type SubcategoryLeafData struct {
	Period      Period
	Category    string
	Subcategory string
	BackQuery   string
	Rows        []MovementRow
	Total       string
	MoreHref    string
	Empty       bool
}

templ SubcategoryLeaf(data SubcategoryLeafData) {
	@PeriodHeader(data.Period)
	<a class="tappable" href={ templ.SafeURL(data.BackQuery) } hx-get={ data.BackQuery } hx-target="#content" hx-push-url="true" hx-indicator="#content">&larr; Volver a { data.Category }</a>
	<h1>{ data.Subcategory }</h1>
	if data.Empty {
		@EmptyState("Sin gastos en esta subcategoría.")
	} else {
		@movementList(data.Rows)
		@movementMore(data.MoreHref)
		<p class="balance-line">
			<span>Total</span>
			<span class="money">{ data.Total }</span>
		</p>
	}
}

templ categoryTable(data CategoriesData, header string) {
	<div class="cat-table-scroll">
		<table class="cat-table" aria-label={ TableLabel(header) }>
			<thead>
				<tr><th scope="col">{ header }</th><th scope="col">Total</th><th scope="col">%</th><th scope="col">Por día</th></tr>
			</thead>
			<tbody>
				for _, row := range data.Rows {
					<tr>
						<th scope="row">
							if row.Href != "" {
								<a class="row-link" href={ row.Href } hx-get={ row.Href } hx-target="#content" hx-push-url="true" hx-indicator="#content">{ row.Icon } { row.Category }</a>
							} else {
								{ row.Icon } { row.Category }
							}
						</th>
						<td class="money">{ row.Total }</td>
						<td class="money muted">{ row.Share }</td>
						<td class="money muted">{ row.PerDay }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	<p class="muted">{ data.PerDayNote }</p>
}

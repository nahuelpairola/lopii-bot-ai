package templates

// BarChartData is the JSON shape read by app.js's "bar-single" chart type.
type BarChartData struct {
	Labels []string  `json:"labels"`
	Values []float64 `json:"values"`
	Color  string    `json:"color"`
}

type CategoryRow struct {
	Category string
	Icon     string
	Href     string // "" on the drill view — a subcategory has nothing below it
	Total    string
	Share    string
}

// CategoriesData renders both the top-level Categorías view and the
// subcategory drill (same shape, different query).
type CategoriesData struct {
	Period Period
	Rows   []CategoryRow
	Chart  BarChartData
	Total  string
	Drill  string
	Empty  bool
}

templ Categories(data CategoriesData) {
	@PeriodHeader(data.Period)
	if data.Empty {
		@EmptyState("Sin gastos en este período.")
	} else {
		<canvas id="categorias-bars" data-chart-type="bar-single" data-chart-data-id="categorias-bars-data"></canvas>
		@templ.JSONScript("categorias-bars-data", data.Chart)
		@categoryTable(data, "Categoría")
	}
}

templ SubcategoryDrill(data CategoriesData) {
	@PeriodHeader(data.Period)
	<h2>{ data.Drill }</h2>
	<a href={ data.Period.Query() } hx-get={ data.Period.Query() } hx-target="#content" hx-push-url="true" hx-indicator="#content">&larr; Volver a Categorías</a>
	if data.Empty {
		@EmptyState("Sin gastos en esta categoría.")
	} else {
		<canvas id="subcat-bars" data-chart-type="bar-single" data-chart-data-id="subcat-bars-data"></canvas>
		@templ.JSONScript("subcat-bars-data", data.Chart)
		@categoryTable(data, "Subcategoría")
	}
}

// categoryTable is shared by both views: the drill is the same table with a
// different header and no links.
templ categoryTable(data CategoriesData, header string) {
	<table>
		<thead>
			<tr><th scope="col">{ header }</th><th scope="col">Total</th><th scope="col">%</th></tr>
		</thead>
		<tbody>
			for _, row := range data.Rows {
				<tr>
					<td>
						if row.Href != "" {
							<a href={ row.Href } hx-get={ row.Href } hx-target="#content" hx-push-url="true" hx-indicator="#content">{ row.Icon } { row.Category }</a>
						} else {
							{ row.Icon } { row.Category }
						}
					</td>
					<td class="money">{ row.Total }</td>
					<td class="money muted">{ row.Share }</td>
				</tr>
			}
		</tbody>
		<tfoot>
			<tr><th scope="row">Total</th><td class="money">{ data.Total }</td><td></td></tr>
		</tfoot>
	</table>
}

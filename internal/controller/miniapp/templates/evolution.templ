package templates

type EvolutionCell struct {
	Value     string
	Intensity string // "" | CellMild | CellHigh
}

type EvolutionRow struct {
	Label string
	Icon  string
	Href  string
	Sub   bool // a subcategory row of the expanded category
	Cells []EvolutionCell
}

type EvolutionData struct {
	Period   Period
	Months   []string
	Rows     []EvolutionRow
	Totals   []EvolutionCell
	Expanded string
	Empty    bool
}

templ Evolution(data EvolutionData) {
	@PeriodHeader(data.Period)
	if data.Empty {
		@EmptyState("Sin gastos en este período.")
	} else {
		<h1>Gasto por categoría{ ScaleNote(data.Period.Currency) }</h1>
		<div class="evolution-scroll">
			<table class="evolution">
				<thead>
					<tr>
						<th scope="col">Categoría</th>
						for _, month := range data.Months {
							<th scope="col">{ ShortMonth(month) }</th>
						}
					</tr>
					<tr class="evolution-totals">
						<th scope="row">Total</th>
						for _, cell := range data.Totals {
							<td class="money">{ cell.Value }</td>
						}
					</tr>
				</thead>
				<tbody>
					for _, row := range data.Rows {
						<tr
							if row.Sub {
								class="evolution-sub"
							}
						>
							<th scope="row">
								if row.Href != "" {
									<a class="row-link" href={ row.Href } hx-get={ row.Href } hx-target="#content" hx-push-url="true" hx-indicator="#content">{ row.Icon } { row.Label }</a>
								} else {
									{ row.Icon } { row.Label }
								}
							</th>
							for _, cell := range row.Cells {
								<td class={ "money", cell.Intensity }>{ cell.Value }</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class="muted evolution-legend">La sombra marca los meses por encima de tu promedio en esa fila. Tocá una categoría para abrir sus subcategorías.</p>
	}
}

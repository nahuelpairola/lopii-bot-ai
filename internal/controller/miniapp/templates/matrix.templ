package templates

type MatrixCell struct {
	Value     string
	Intensity string // "" | CellMild | CellHigh
}

type MatrixRow struct {
	Label string
	Icon  string
	Href  string
	Sub   bool // a subcategory row of the expanded category
	Cells []MatrixCell
}

type MatrixData struct {
	Period   Period
	Months   []string
	Rows     []MatrixRow
	Totals   []MatrixCell
	Expanded string
	Empty    bool
}

templ Matrix(data MatrixData) {
	@PeriodHeader(data.Period)
	if data.Empty {
		@EmptyState("Sin gastos en este período.")
	} else {
		<div class="matrix-scroll">
			<table class="matrix">
				<caption>Gasto por categoría · { data.Period.Label }</caption>
				<thead>
					<tr>
						<th scope="col">Categoría</th>
						for _, month := range data.Months {
							<th scope="col">{ ShortMonth(month) }</th>
						}
					</tr>
					<tr class="matrix-totals">
						<th scope="row">Total</th>
						for _, cell := range data.Totals {
							<td class="money">{ cell.Value }</td>
						}
					</tr>
				</thead>
				<tbody>
					for _, row := range data.Rows {
						<tr
							if row.Sub {
								class="matrix-sub"
							}
						>
							<th scope="row">
								if row.Href != "" {
									<a href={ row.Href } hx-get={ row.Href } hx-target="#content" hx-push-url="true" hx-indicator="#content">{ row.Icon } { row.Label }</a>
								} else {
									{ row.Icon } { row.Label }
								}
							</th>
							for _, cell := range row.Cells {
								<td class={ "money", cell.Intensity }>{ cell.Value }</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class="muted matrix-legend">La sombra marca los meses por encima de tu promedio en esa fila. Tocá una categoría para abrir sus subcategorías.</p>
	}
}

package templates

templ movementList(rows []MovementRow) {
	for _, group := range GroupRowsByDay(rows) {
		<section class="mov-group">
			@GroupTitle(group.Date)
			<ul class="mov-list">
				for _, row := range group.Rows {
					<li class="mov-row">
						if row.Icon != "" {
							<span class="mov-icon" aria-hidden="true">{ row.Icon }</span>
						}
						<span class="mov-text">
							<span class="mov-title">{ row.Title }</span>
							if row.Note != "" {
								<span class="mov-meta">{ row.Note }</span>
							}
						</span>
						<span class="money mov-amount">{ row.Amount }</span>
					</li>
				}
			</ul>
		</section>
	}
}

templ movementMore(href string) {
	if href != "" {
		<div id="mov-more" class="mov-more" hx-get={ href } hx-trigger="revealed" hx-target="#mov-more" hx-swap="outerHTML"></div>
	}
}

templ MovementFragment(rows []MovementRow, moreHref string) {
	@movementList(rows)
	@movementMore(moreHref)
}

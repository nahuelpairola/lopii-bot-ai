package templates

// TrendChartData is the JSON shape read by app.js's "bar-grouped"/"line-multi"
// chart types (see static/app.js): Chart.js's {labels, datasets} shape directly.
// Exported: built by package miniapp's handlers, rendered by this package.
type TrendChartData struct {
	Labels   []string        `json:"labels"`
	Datasets []TrendDataset  `json:"datasets"`
}

type TrendDataset struct {
	Label           string    `json:"label"`
	Data            []float64 `json:"data"`
	BackgroundColor string    `json:"backgroundColor"`
}

// OverviewData is what Overview renders.
type OverviewData struct {
	Period     Period
	Gastos     string
	Ingresos   string
	Neto       string
	NetoStatus string // "good" | "critical"
	Empty      bool
	TrendChart TrendChartData
	// Variacion is what the balances did with no real transaction behind it
	// (balance adjustments, investment yield), signed. It is deliberately NOT
	// one of the three KPIs: it is not money earned or spent, and blending it
	// into Ingresos is what made a CEDEAR revaluation read as salary.
	// HasVariacion gates the whole row — a period without adjustments should
	// not spend screen space saying "nothing happened".
	HasVariacion bool
	Variacion    string
	// IsAdmin muestra el acceso a /app/admin. La ruta es la única sin pestaña
	// en la tabbar, así que sin este link no hay forma de llegar: un webview no
	// tiene barra de direcciones.
	IsAdmin bool
}

// The <h2> the view used to open with is gone: the tab already says where you
// are, and the period header earns that space by saying *when* you are.
templ Overview(data OverviewData) {
	@PeriodHeader(data.Period)
	<div class="grid">
		<article>
			<p>Gastos</p>
			<p class="money">{ data.Gastos }</p>
		</article>
		<article>
			<p>Ingresos</p>
			<p class="money">{ data.Ingresos }</p>
		</article>
		<article>
			<p>Neto</p>
			<p
				if data.NetoStatus == NetoGood {
					class="money neto-good"
				} else {
					class="money neto-critical"
				}
			>{ data.Neto }</p>
		</article>
	</div>
	if data.HasVariacion {
		<p class="variacion">
			<span>📈 Variación de saldos</span>
			<span class="money">{ data.Variacion }</span>
			<small>Ajustes y rendimiento — no cuenta como gasto ni ingreso</small>
		</p>
	}
	if data.Empty {
		@EmptyState("Sin movimientos en este período.")
	} else {
		<canvas id="resumen-trend" data-chart-type="bar-grouped" data-chart-data-id="resumen-trend-data"></canvas>
		@templ.JSONScript("resumen-trend-data", data.TrendChart)
	}
	if data.IsAdmin {
		// No se ve acá: hx-swap-oob lo saca del #content y lo mete en el slot
		// que el TabBar dejó reservado, así que aterriza como una pestaña más
		// del menú. Viaja con el Resumen porque es la primera respuesta
		// autenticada — la única que sabe que quien mira es admin.
		//
		// Sin href/hx-target propios: al entrar al <nav> hereda hx-target,
		// hx-push-url, hx-include y hx-indicator de él, igual que las otras
		// cuatro. aria-current lo pone markActiveTab (app.js) contra data-tab.
		<a
			id={ AdminTabSlotID }
			hx-swap-oob="true"
			class="tab-link"
			data-tab={ AdminPath }
			href={ RouteAdmin }
			hx-get={ RouteAdmin }
		>Admin</a>
	}
}

package templates

type TrendChartData struct {
	Labels   []string        `json:"labels"`
	Datasets []TrendDataset  `json:"datasets"`
}

type TrendDataset struct {
	Label string    `json:"label"`
	Data  []float64 `json:"data"`
	Role            string `json:"role,omitempty"`
	BackgroundColor string `json:"backgroundColor,omitempty"`
}

type OverviewData struct {
	Period     Period
	Gastos     string
	Ingresos   string
	Neto       string
	NetoStatus string
	Empty      bool
	TrendChart TrendChartData
	HasVariacion bool
	Variacion    string
}

templ Overview(data OverviewData) {
	@PeriodHeader(data.Period)
	<h1 class="sr-only">Resumen</h1>
	<div class="grid">
		<article>
			<p>Gastos</p>
			<p class="money">{ data.Gastos }</p>
		</article>
		<article>
			<p>Ingresos</p>
			<p class="money">{ data.Ingresos }</p>
		</article>
		<article>
			<p>Neto</p>
			<p
				if data.NetoStatus == NetoGood {
					class="money neto-good"
				} else {
					class="money neto-critical"
				}
			>{ data.Neto }</p>
		</article>
	</div>
	if data.HasVariacion {
		<p class="variacion">
			<span>📈 Variación de saldos</span>
			<span class="money">{ data.Variacion }</span>
			<small>Ajustes y rendimiento — no cuenta como gasto ni ingreso</small>
		</p>
	}
	if data.Empty {
		@EmptyState("Sin movimientos en este período.")
	} else {
		<div class="chart-box">
			<canvas id="resumen-trend" role="img" aria-label={ TrendChartAlt("gastos e ingresos", data.TrendChart, data.Period.Currency) } data-chart-type="bar-grouped" data-chart-data-id="resumen-trend-data"></canvas>
		</div>
		@templ.JSONScript("resumen-trend-data", data.TrendChart)
	}
}

package templates

import "lopiibot.com/internal/currency"

templ AppState(p Period) {
	<div id="app-state" hidden>
		for _, s := range PresetScopes {
			<input type="hidden" name={ s.Param } value={ p.Presets[s.Param] }/>
		}
		<input type="hidden" name="m" value={ p.AnchorKey() }/>
		<input type="hidden" name="c" value={ p.Currency.String() }/>
	</div>
}

templ PeriodHeader(p Period) {
	@AppState(p)
	<header class="period-header">
		<div class="period-cursor">
			if p.PrevQuery != "" {
				<a href={ p.PrevQuery } hx-get={ p.PrevQuery } hx-target="#content" hx-push-url="true" hx-indicator="#content" aria-label="Período anterior">&lsaquo;</a>
			} else {
				<span class="period-cursor-off" aria-hidden="true">&lsaquo;</span>
			}
			<strong>{ p.Label }</strong>
			if p.NextQuery != "" {
				<a href={ p.NextQuery } hx-get={ p.NextQuery } hx-target="#content" hx-push-url="true" hx-indicator="#content" aria-label="Período siguiente">&rsaquo;</a>
			} else {
				<span class="period-cursor-off" aria-hidden="true">&rsaquo;</span>
			}
		</div>
		<div
			class="chips"
			role="group"
			if p.HideCurrency {
				aria-label="Período"
			} else {
				aria-label="Período y moneda"
			}
		>
			for _, preset := range p.Scope.Allowed {
				<a
					role="button"
					class="outline chip"
					href={ p.WithPreset(preset) }
					hx-get={ p.WithPreset(preset) }
					hx-target="#content"
					hx-push-url="true"
					hx-indicator="#content"
					if p.IsPreset(preset) {
						aria-current="page"
					}
				>{ PresetLabel(preset) }</a>
			}
			if !p.HideCurrency {
				<span class="chips-sep"></span>
				for _, cur := range currency.SupportedCurrencies {
					<a
						role="button"
						class="outline chip"
						href={ p.WithCurrency(cur) }
						hx-get={ p.WithCurrency(cur) }
						hx-target="#content"
						hx-push-url="true"
						hx-indicator="#content"
						if p.Currency == cur {
							aria-current="page"
						}
					>{ cur.String() }</a>
				}
			}
		</div>
	</header>
}

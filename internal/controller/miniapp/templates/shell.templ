package templates

templ Shell(active string, loadPath string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ AppName }</title>
			<script src="https://telegram.org/js/telegram-web-app.js"></script>
			<link rel="stylesheet" href="/app/static/pico.min.css"/>
			<link rel="stylesheet" href="/app/static/app.css"/>
			<script src="/app/static/chart.umd.min.js"></script>
			<script src="/app/static/htmx.min.js"></script>
			<script src="/app/static/app.js"></script>
		</head>
		<body>
			<main class="container content-area" id="content" hx-get={ loadPath } hx-trigger="load">
				<p aria-busy="true">Cargando…</p>
			</main>
			@TabBar(active)
		</body>
	</html>
}

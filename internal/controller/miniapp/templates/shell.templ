package templates

templ Shell(active string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Mis finanzas</title>
			<script src="https://telegram.org/js/telegram-web-app.js"></script>
			<link rel="stylesheet" href="/app/static/pico.min.css"/>
			<link rel="stylesheet" href="/app/static/app.css"/>
			<script src="/app/static/chart.umd.min.js"></script>
			<script src="https://unpkg.com/htmx.org@2"></script>
			<script src="/app/static/app.js"></script>
		</head>
		<body>
			<main class="container content-area" id="content">
				@content
			</main>
			@TabBar(active)
		</body>
	</html>
}

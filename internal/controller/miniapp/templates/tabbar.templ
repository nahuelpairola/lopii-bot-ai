package templates

// TabBar is rendered once, in the shell, and never swapped — so its links
// cannot carry the current period in their hrefs. hx-include="#app-state"
// pulls it from the hidden inputs every partial renders (see PeriodHeader),
// and htmx serializes them into the GET query the normal way, so hx-push-url
// reflects them too.
templ TabBar(active string) {
	<nav class="tab-bar" hx-include="#app-state" hx-target="#content" hx-push-url="true" hx-indicator="#content">
		@tabLink(RouteOverview, TabOverview, "Resumen", active)
		@tabLink(RouteCategories, TabCategories, "Categorías", active)
		@tabLink(RouteEvolution, TabEvolution, "Evolución", active)
		@tabLink(RouteAccounts, TabAccounts, "Cuentas", active)
		// Slot de la pestaña de admin. Va vacío y oculto porque acá todavía no
		// se sabe quién mira: el Shell no está autenticado. El partial del
		// Resumen lo reemplaza por la pestaña real con hx-swap-oob cuando el
		// que pide es admin. `hidden` lo saca del flex, así que para un usuario
		// común las cuatro pestañas quedan repartidas como si no existiera.
		<span id={ AdminTabSlotID } hidden></span>
	</nav>
}

// tabLink marks the active tab with aria-current rather than <strong>: pico
// styles [aria-current] already, and app.js can re-mark it after an htmx swap
// (the tab bar itself never re-renders).
templ tabLink(route, tab, label, active string) {
	<a
		class="tab-link"
		data-tab={ tab }
		href={ route }
		hx-get={ route }
		if active == tab {
			aria-current="page"
		}
	>{ label }</a>
}

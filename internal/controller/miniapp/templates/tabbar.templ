package templates

templ TabBar(active string) {
	<nav class="tab-bar" aria-label="Secciones" hx-include="#app-state" hx-target="#content" hx-push-url="true" hx-indicator="#content">
		@tabLink(RouteOverview, TabOverview, "Resumen", active)
		@tabLink(RouteCategories, TabCategories, "Categorías", active)
		@tabLink(RouteAccounts, TabAccounts, "Cuentas", active)
		@tabLink(RouteEvolution, TabEvolution, "Evolución", active)
	</nav>
}

templ tabLink(route, tab, label, active string) {
	<a
		class="tab-link"
		data-tab={ tab }
		href={ route }
		hx-get={ route }
		if active == tab {
			aria-current="page"
		}
	>{ label }</a>
}
